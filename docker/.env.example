# Copy this file outside the image and mount it as /root/VTLA-RL/.env.
# Keep the file mode restrictive (for example: chmod 600 vtla.env).
HF_TOKEN=replace-with-huggingface-token
WANDB_API_KEY=replace-with-wandb-api-key

# Optional build mirror overrides (these are not credentials).
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PYTORCH_INDEX_URL=https://mirror.sjtu.edu.cn/pytorch-wheels/cu128
HF_ENDPOINT=https://hf-mirror.com

# Optional bind-mount overrides. Keep models and datasets on their existing
# storage, and point writable run artifacts at a filesystem with enough room.
# TABERO_DATASETS_HOST=/absolute/path/to/datasets
# TABERO_MODELS_HOST=/absolute/path/to/models
# TABERO_RESULTS_HOST=/absolute/path/to/results
# TABERO_RECORD_HOST=/absolute/path/to/Record
